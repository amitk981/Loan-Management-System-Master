FROM python:3.11.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system --gid 10001 sfpcl \
    && adduser --system --uid 10001 --ingroup sfpcl --home /home/sfpcl sfpcl \
    && mkdir -p /var/lib/sfpcl/storage/documents /var/lib/sfpcl/storage/report-exports \
    && chown -R sfpcl:sfpcl /var/lib/sfpcl /home/sfpcl

COPY sfpcl_credit/requirements.txt /tmp/requirements.txt
RUN python -m pip install --requirement /tmp/requirements.txt

COPY --chown=sfpcl:sfpcl sfpcl_credit /app/sfpcl_credit

USER sfpcl

EXPOSE 8000

CMD ["gunicorn", "--bind=0.0.0.0:8000", "--workers=3", "--timeout=120", "--access-logfile=-", "--error-logfile=-", "sfpcl_credit.config.wsgi:application"]
